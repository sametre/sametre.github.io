1:["$","main",null,{"children":[["$","header",null,{"className":"nav shell","children":[["$","a",null,{"className":"brand","href":"/","aria-label":"Ana sayfa","children":[["$","img",null,{"src":"/logo.svg","alt":"Samet ER — Salesforce Developer"}],["$","span",null,{"className":"salesforce-badge","children":[["$","img",null,{"src":"https://cdn.simpleicons.org/salesforce/00A1E0","alt":"","width":"18","height":"18"}],["$","span",null,{"children":"Agentforce"}]]}]]}],["$","nav",null,{"aria-label":"Ana menü","children":[["$","a",null,{"href":"/en/projects","children":"Projects"}],["$","a",null,{"href":"/en/services","children":"Services"}],["$","a",null,{"href":"/en/about","children":"About"}],["$","a",null,{"href":"/en/blog","children":"Blog"}]]}],["$","a",null,{"className":"language-switch","href":"/","lang":"tr","children":"TR"}],["$","a",null,{"className":"nav-cta","href":"https://www.linkedin.com/in/samet-er-75915a3a3/","target":"_blank","rel":"noreferrer","children":["Let's work together"," ",["$","span",null,{"children":"↗"}]]}]]}],["$","article",null,{"className":"shell blog-article","children":[["$","a",null,{"className":"blog-back","href":"/en/blog","children":"← All articles"}],["$","div",null,{"className":"blog-article-heading","children":[["$","span",null,{"className":"section-number","children":"Technical note"}],["$","h1",null,{"children":"How should ERP, CRM and e-commerce integration be designed?"}],["$","p",null,{"children":"A sustainable integration architecture that manages inventory, customers and orders through a shared data model."}],["$","time",null,{"dateTime":"2026-07-31","children":"2026-07-31"}]]}],["$","div",null,{"className":"blog-body","children":[["$","p","ERP, CRM and e-commerce serve different responsibilities. ERP owns inventory and finance, CRM manages customer relationships, and commerce delivers the ordering experience. Disconnected systems create stock errors, duplicate customers and delayed orders.",{"children":"ERP, CRM and e-commerce serve different responsibilities. ERP owns inventory and finance, CRM manages customer relationships, and commerce delivers the ordering experience. Disconnected systems create stock errors, duplicate customers and delayed orders."}],["$","p","A reliable design starts by assigning a system of record for every domain. Product and stock may belong to ERP, engagement to CRM, and checkout to commerce, while all platforms share stable product, customer and order identifiers.",{"children":"A reliable design starts by assigning a system of record for every domain. Product and stock may belong to ERP, engagement to CRM, and checkout to commerce, while all platforms share stable product, customer and order identifiers."}],["$","p","REST APIs, webhooks and queues should be selected by business urgency. Inventory and order events may need near-real-time delivery, while reporting workloads can run asynchronously.",{"children":"REST APIs, webhooks and queues should be selected by business urgency. Inventory and order events may need near-real-time delivery, while reporting workloads can run asynchronously."}],["$","p","Retries, idempotency, monitoring and operational recovery screens make the integration sustainable. The goal is one trusted operational truth for every team.",{"children":"Retries, idempotency, monitoring and operational recovery screens make the integration sustainable. The goal is one trusted operational truth for every team."}]]}]]}],["$","section",null,{"className":"contact page-contact","children":["$","footer",null,{"className":"shell","children":[["$","a",null,{"className":"brand","href":"/","aria-label":"Ana sayfaya dön","children":["$","img",null,{"src":"/logo.svg","alt":"Samet ER — Salesforce Developer"}]}],["$","p",null,{"children":["© 2026 Samet ER. Bursa, ","Türkiye","."]}],["$","div",null,{"children":[["$","a",null,{"href":"https://www.linkedin.com/in/samet-er-75915a3a3/","target":"_blank","rel":"noreferrer","children":"LinkedIn"}],"$Le"]}]]}]}]]}]
